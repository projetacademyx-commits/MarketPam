# MonCash credentials belong in your private deployment environment or ignored .env.local.
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=

# Use sandbox while testing; change to "production" only after validation with Digicel.
MONCASH_MODE=sandbox

# Required: current HTG per 1 USD. Keep this rate updated by the merchant.
MONCASH_USD_TO_HTG_RATE=

# Register this URL as the return/callback URL in the MonCash merchant portal.
# https://your-public-domain.example/api/moncash/return